{
  "name": "@mrjoshida/synth-engine",
  "version": "0.5.1",
  "description": "Shared multi-engine synthesizer, Web MIDI manager, and FX library for FWDBIAS apps",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "workbench.html"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cli": "node test-cli.mjs",
    "workbench": "npx serve -l 5175 .",
    "demo": "vite demo",
    "demo:build": "vite build demo",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@mrjoshida/music-theory": "github:mrjoshida/music-theory",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "jsdom": "^30.0.1",
    "standardized-audio-context-mock": "^10.0.1",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vite": "^6.0.0",
    "vitest": "^3.0.5"
  }
}
